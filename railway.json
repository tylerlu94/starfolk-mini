{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build --workspace @sfkm/devbox-runtime"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @sfkm/server",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
